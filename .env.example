# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fleetpro:fleetpro@localhost:5432/fleetpro?schema=public"

# ─── Auth (Auth.js) ─────────────────────────────────────────────────────
AUTH_SECRET="change-me-32-bytes-of-base64"
AUTH_URL="http://localhost:3000"

# ─── Object storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ─────
S3_REGION="eu-west-2"
S3_BUCKET="fleetpro-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""           # leave blank for AWS, set for R2/MinIO
S3_KMS_KEY_ID=""         # AWS KMS CMK for licence-image encryption at rest

# ─── Redis (BullMQ queues for agent workloads) ──────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Anthropic (agent runtime) ──────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ─── DVLA / DVSA (vehicle data) ─────────────────────────────────────────
DVSA_MOT_HISTORY_API_KEY=""
DVSA_MOT_CLIENT_ID=""
DVSA_MOT_CLIENT_SECRET=""
DVLA_VES_API_KEY=""

# ─── Adobe Acrobat Sign (e-signatures) ──────────────────────────────────
ADOBE_SIGN_INTEGRATION_KEY=""
ADOBE_SIGN_WEBHOOK_SECRET=""

# ─── Calendar (Google + Microsoft Graph) ────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_JSON=""
MICROSOFT_GRAPH_CLIENT_ID=""
MICROSOFT_GRAPH_CLIENT_SECRET=""
MICROSOFT_GRAPH_TENANT_ID=""

# ─── Telematics (operator-provided GPS API) ─────────────────────────────
TELEMATICS_API_BASE_URL=""
TELEMATICS_API_KEY=""

# ─── Used-car valuations (CAP HPI / Glass's / AutoTrader Retail Rating) ─
VALUATION_PROVIDER="cap-hpi"   # cap-hpi | glass | autotrader
VALUATION_API_KEY=""

# ─── Procurement feeds ──────────────────────────────────────────────────
COPART_API_KEY=""
IAA_API_KEY=""
EBAY_OAUTH_TOKEN=""
AUTOTRADER_API_KEY=""
CAR_AND_CLASSIC_API_KEY=""
FACEBOOK_MARKETPLACE_TOKEN=""

# ─── OCR (Google Vision / AWS Textract) ─────────────────────────────────
OCR_PROVIDER="aws-textract"    # aws-textract | google-vision
OCR_API_KEY=""

# ─── Operational ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="FleetPro"
APPROVAL_QUEUE_BASE_URL="http://localhost:3000/admin/approvals"
LOG_LEVEL="info"
